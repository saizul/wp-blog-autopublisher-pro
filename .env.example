# Copy to .env and fill in. Never commit .env.
WP_URL=https://example.com
WP_USER=your-wp-username
# Create under Users > Profile > Application Passwords in wp-admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# Optional: IANA timezone used for naive publish_at values (default UTC)
WP_TIMEZONE=UTC
